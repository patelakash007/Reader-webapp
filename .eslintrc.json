{
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "overrides": [
    {
      "files": ["src/**/*.mjs"],
      "env": {
        "browser": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["script.js"],
      "env": {
        "browser": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["sw.js"],
      "env": {
        "serviceworker": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["scripts/**/*.js"],
      "env": {
        "node": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["scripts/*playwright*.js"],
      "env": {
        "node": true,
        "browser": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "env": {
        "node": true,
        "es2024": true
      },
      "parserOptions": {
        "sourceType": "script"
      },
      "globals": {
        "NodeFilter": "writable",
        "SpeechSynthesisUtterance": "writable"
      }
    }
  ]
}
